# Copy to .env and fill in real values. NEVER commit the real .env.
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/pakev

# Gmail account + app password used for OTP / order notification mail
EMAIL_USER=example@gmail.com
EMAIL_PASS=your-gmail-app-password

# Signing key for JWTs. Must be at least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma separated list of browser origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.example.com

# OAuth client id of the frontend Google sign-in button. Access tokens that were
# not issued for this client id are rejected.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# Shared secret required by POST /api/admin/init (min 16 chars). Unset = the
# bootstrap endpoint is disabled, which is the right setting once an admin exists.
ADMIN_INIT_SECRET=

NODE_ENV=production
